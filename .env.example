# Copy to .env and replace EVERY placeholder. Never commit .env.
# Generate secrets with:  openssl rand -hex 32

# --- required ---
POSTGRES_PASSWORD=REPLACE_WITH_HEX_PASSWORD        # hex only (it is embedded in a URL)
PG_JWT_SECRET=REPLACE_WITH_64_HEX_CHARS            # >= 32 characters; rotating it logs everyone out

# --- first-run administrator (remove PG_BOOTSTRAP_ADMIN_PASSWORD after the first start) ---
PG_BOOTSTRAP_ADMIN_EMAIL=admin@your-domain.example
PG_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD   # >= 12 chars, mixed case + digit

# --- URLs ---
PG_PUBLIC_BASE_URL=http://localhost:8080           # used in reports/PR comments; https://your-domain in production
PG_CORS_ORIGINS=                                   # empty = same-origin only (recommended behind the bundled nginx/Caddy)

# --- production overlay (docker-compose.prod.yml) ---
PIPELINEGUARD_DOMAIN=pipelineguard.your-domain.example
ACME_EMAIL=ops@your-domain.example

# --- optional tuning (defaults shown) ---
# PG_INGEST_RATE_PER_MINUTE=60
# PG_MAX_BODY_BYTES=26214400
# PG_JWT_TTL_MINUTES=60
# PG_SUPPRESSION_MAX_DAYS=180
# PG_STORE_RAW_REPORTS=true

# --- local development only (rejected when PG_ENVIRONMENT=production) ---
# PG_ENVIRONMENT=development
# PG_SEED_DEMO_DATA=false
