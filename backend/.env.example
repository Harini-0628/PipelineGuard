# Local development settings for running the API outside Docker (copy to backend/.env). Placeholders only.
PG_ENVIRONMENT=development
PG_DATABASE_URL=postgresql+psycopg://pipelineguard:pipelineguard@localhost:5432/pipelineguard
PG_JWT_SECRET=REPLACE_ME_with_output_of__openssl_rand_-hex_32
PG_DEFAULT_POLICY_PATH=../policies/default.yaml
PG_PUBLIC_BASE_URL=http://localhost:5173
PG_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
PG_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
# Optional demo dataset (development only; refused in production):
# PG_SEED_DEMO_DATA=true
